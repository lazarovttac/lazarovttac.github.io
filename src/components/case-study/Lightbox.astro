<!-- Opens gallery images (any img[data-full]) full-size over a darkened overlay.
     Closes on outside click, the × button, or Escape. -->
<div class="lightbox" aria-hidden="true">
  <img class="lightbox__img" alt="" />
  <button class="lightbox__close" aria-label="Close image">×</button>
</div>

<script>
  const overlay = document.querySelector<HTMLElement>(".lightbox")!;
  const viewer = overlay.querySelector<HTMLImageElement>(".lightbox__img")!;

  function open(thumbnail: HTMLImageElement) {
    viewer.src = thumbnail.dataset.full!;
    viewer.alt = thumbnail.alt;
    overlay.classList.add("lightbox--open");
    overlay.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden"; // lock page scroll behind the overlay
  }

  function close() {
    overlay.classList.remove("lightbox--open");
    overlay.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  document.querySelectorAll<HTMLImageElement>("img[data-full]").forEach((thumbnail) => {
    thumbnail.addEventListener("click", () => open(thumbnail));
  });

  // Anything that isn't the image itself counts as "outside" (× included).
  overlay.addEventListener("click", (event) => {
    if (event.target !== viewer) close();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") close();
  });
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;

    background-color: var(--overlay-color);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .lightbox--open {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: calc(100vh - 80px);
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 24px 60px color-mix(in srgb, var(--shadow-color) 50%, transparent);

    transform: scale(0.94);
    transition:
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.2s ease;
    opacity: 0;
  }

  .lightbox--open .lightbox__img {
    transform: scale(1);
    opacity: 1;
  }

  .lightbox__close {
    position: fixed;
    top: 18px;
    right: 22px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background-color: color-mix(in srgb, var(--on-accent) 12%, transparent);
    color: var(--on-accent);
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background-color 0.2s,
      transform 0.2s;
  }

  .lightbox__close:hover {
    background-color: color-mix(in srgb, var(--on-accent) 25%, transparent);
    transform: scale(1.1);
  }
</style>
