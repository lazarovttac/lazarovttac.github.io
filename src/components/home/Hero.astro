---
import { Image } from "astro:assets";
import Button from "../Button.astro";
import Translated from "../Translated.astro";
import portrait from "../../assets/images/me.png";
---

<section class="landing" id="landing">
  <div class="hero">
    <div class="hero-name-title">
      <p class="name">Lázaro Ventancor Cressatti</p>
      <Translated as="h1" class="title" k="hero_title" />
      <Translated as="p" class="hero-subtitle" k="hero_subtitle" />
      <div class="hero-ctas">
        <Button href="#projects" variant="primary" k="hero_btn_projects" />
        <Button href="https://www.linkedin.com/in/lazarovttac" variant="linkedin">LinkedIn</Button>
      </div>
    </div>
    <div class="hero-visuals">
      <div class="image-wrapper">
        <Image src={portrait} alt="Lázaro Ventancor" width={350} loading="eager" />
      </div>
      <div class="floating-tags">
        <Translated as="span" class="tag" k="tag_trading" />
        <Translated as="span" class="tag" k="tag_ai" />
        <Translated as="span" class="tag" k="tag_uiux" />
        <Translated as="span" class="tag" k="tag_fullstack" />
        <Translated as="span" class="tag" k="tag_e2e" />
      </div>
    </div>
  </div>
</section>

<style>
  .landing {
    width: 100%;
    padding: 50px 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
  }

  .hero {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 40px;
  }

  .hero-name-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 800px;
    z-index: 2;
  }

  .name {
    font-family: "Geist", sans-serif;
    font-weight: 600;
    font-size: 2rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .title {
    font-family: "Geist", sans-serif;
    font-weight: 800;
    font-size: clamp(3rem, 6vw, 6.5rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: var(--text-primary);
  }

  .hero-subtitle {
    font-size: 1.8rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 650px;
    margin: 0 auto;
  }

  .hero-ctas {
    display: flex;
    gap: 15px;
    margin-top: 20px;
  }

  .hero-visuals {
    position: relative;
    width: 100%;
    max-width: 900px;
    height: 350px;
    margin-top: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .image-wrapper {
    width: 175px;
    aspect-ratio: 1;
    z-index: 5;
    box-shadow: 0 10px 25px color-mix(in srgb, var(--shadow-color) 8%, transparent);
    border-radius: 50%;
    transition:
      transform 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275),
      box-shadow 0.7s ease;

    cursor: pointer;
  }

  .image-wrapper:hover {
    transform: scale(1.05);
    box-shadow:
      0 8px 24px color-mix(in srgb, var(--shadow-color) 10%, transparent),
      0 0 16px color-mix(in srgb, var(--shadow-color) 4%, transparent);
  }

  .image-wrapper img {
    width: 105%;
    height: 105%;
    object-fit: cover;

    border-radius: 50%;

    filter: brightness(1.05);
  }

  /* Floating Tags */
  .floating-tags {
    position: absolute;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 6;
  }

  .tag {
    position: absolute;
    padding: 8px 16px;
    border-radius: 999px;
    font-family: "JetBrains Mono", monospace;
    font-weight: 600;
    font-size: 1.3rem;
    box-shadow: 0 4px 12px color-mix(in srgb, var(--shadow-color) 4%, transparent);
    border: 1px solid var(--tag-border);
    animation: floatMotion 6s ease-in-out infinite;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    margin: 0;
    transition: margin 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .image-wrapper:hover + .floating-tags .tag:nth-child(1) {
    margin-top: -20px;
    margin-left: -20px;
  }
  .image-wrapper:hover + .floating-tags .tag:nth-child(2) {
    margin-top: 20px;
    margin-left: -20px;
  }
  .image-wrapper:hover + .floating-tags .tag:nth-child(3) {
    margin-bottom: -20px;
    margin-right: -20px;
  }
  .image-wrapper:hover + .floating-tags .tag:nth-child(4) {
    margin-top: -20px;
    margin-right: -20px;
  }
  .image-wrapper:hover + .floating-tags .tag:nth-child(5) {
    margin-top: 20px;
    margin-right: -20px;
  }

  .tag:nth-child(1) {
    background-color: var(--tag-1-bg);
    color: var(--tag-1-text);
    top: 10%;
    left: 25%;
    --rot: -5deg;
    transform: rotate(var(--rot));
    animation-delay: 0s;
  }

  .tag:nth-child(2) {
    background-color: var(--tag-2-bg);
    color: var(--tag-2-text);
    top: 60%;
    left: 20%;
    --rot: 5deg;
    transform: rotate(var(--rot));
    animation-delay: 1.5s;
  }

  .tag:nth-child(3) {
    background-color: var(--tag-3-bg);
    color: var(--tag-3-text);
    bottom: 20%;
    right: 20%;
    --rot: -8deg;
    transform: rotate(var(--rot));
    animation-delay: 3s;
  }

  .tag:nth-child(4) {
    background-color: var(--tag-4-bg);
    color: var(--tag-4-text);
    top: 15%;
    right: 20%;
    --rot: 10deg;
    transform: rotate(var(--rot));
    animation-delay: 4.5s;
  }

  .tag:nth-child(5) {
    background-color: var(--tag-5-bg);
    color: var(--tag-5-text);
    top: 85%;
    right: 45%;
    --rot: 10deg;
    transform: rotate(var(--rot));
    animation-delay: 4.5s;
  }

  @keyframes floatMotion {
    0%,
    100% {
      transform: translateY(0) rotate(var(--rot));
    }
    50% {
      transform: translateY(-15px) rotate(var(--rot));
    }
  }

  @media (max-width: 700px) {
    .tag {
      font-size: 1.1rem;
      padding: 6px 12px;
    }

    .tag:nth-child(1) {
      top: 5%;
      left: 5%;
    }

    .tag:nth-child(2) {
      top: 45%;
      left: 2%;
    }

    .tag:nth-child(3) {
      bottom: 15%;
      right: 2%;
    }

    .tag:nth-child(4) {
      top: 10%;
      right: 5%;
    }

    .tag:nth-child(5) {
      top: auto;
      bottom: 5%;
      right: auto;
      left: 10%;
    }
  }
</style>
