---
import { getImage } from "astro:assets";
import Contact from "../components/Contact.astro";
import Dock from "../components/Dock.astro";
import FloatingControls from "../components/FloatingControls.astro";
import faviconSource from "../assets/images/icons/favicon.png";
import { THEME_STORAGE_KEY } from "../theme";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// `build.format: "file"` reports the home page as /index.html; Pages serves it at /.
const path = Astro.url.pathname.replace(/\/index\.html$/, "/");
const isHome = path === "/";
const canonical = new URL(path, Astro.site);
const favicon = await getImage({ src: faviconSource, width: 180, format: "png" });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Runs before first paint so a dark theme never flashes white. -->
    <script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
      const saved = localStorage.getItem(storageKey);
      const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.dataset.theme =
        saved === "dark" || saved === "light" ? saved : prefersDark ? "dark" : "light";
    </script>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Inter:wght@100..900&family=JetBrains+Mono:wght@100..800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={favicon.src} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <div class="page-wrapper">
      <Dock isHome={isHome} />
      <slot />
      <Contact />
    </div>
    <FloatingControls />
  </body>
</html>

<style>
  .page-wrapper {
    position: relative;
    width: 100%;
    max-width: 1230px;
    margin: 0 auto;
    padding: 0 45px;

    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    min-height: 100vh;
  }

  @media (max-width: 700px) {
    .page-wrapper {
      padding: 0 25px;
      /* Offset page content so it starts below the header */
      padding-top: 60px;
    }
  }
</style>
